#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32-gpio-sigmap.h>

/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };

    aliases {
        simuart = &uart1;
        modem = &sim7000;
    };
};

&pinctrl {
    uart1_sim_default: uart1_sim_default {
        group1 {
            pinmux = <UART1_TX_GPIO27>;
            output-enable;
        };
        group2 {
            pinmux = <UART1_RX_GPIO26>;
            bias-pull-up;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_sim_default>;
    pinctrl-names = "default";

    sim7000: modem {
        compatible = "simcom,sim7000";
        status = "okay";

        mdm-power-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;

		

        /* Optional if wired */
        /* mdm-reset-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>; */
        /* mdm-wake-gpios  = <&gpio0 6 GPIO_ACTIVE_HIGH>; */
        /* mdm-ring-gpios  = <&gpio0 7 GPIO_ACTIVE_LOW>; */
        /* mdm-dtr-gpios   = <&gpio0 8 GPIO_ACTIVE_HIGH>; */
    };
};